.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# ============================================================
# NODE.JS / REACT / VITE
# ============================================================

node_modules/

# Vite / frontend build output
frontend/dist/
frontend/build/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node temporary files
.npm/
.yarn/


